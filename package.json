{
  "name": "mawjivo",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "service:artifact": "node scripts/build-service-artifact.mjs",
    "media:tools": "node scripts/fetch-media-tools.mjs",
    "operator:setup": "node scripts/operator-setup.mjs",
    "tauri:build": "pnpm --dir apps/desktop exec tauri build",
    "release:build": "node scripts/operator-release.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:js": "node scripts/verify.mjs --javascript",
    "verify:production": "node scripts/verify-production.mjs",
    "tools:verify": "node scripts/verify-toolchain.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "release:archive": "node scripts/github-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:cleanup": "node scripts/publish-release.mjs --cleanup"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "fast-xml-parser": "5.11.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
