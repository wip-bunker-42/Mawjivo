{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mawjivo",
  "version": "0.1.3",
  "identifier": "com.aimansour.mawjivo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm -w media:tools && pnpm -w service:artifact && pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mawjivo",
        "width": 1050,
        "height": 760,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mawjivo",
    "resources": {
      "media-tools/": "media-tools/",
      "../../../.tools/legal/": "legal/"
    },
    "shortDescription": "النشر الشخصي والجدولة",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wip-bunker-42/Mawjivo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NkQxNUFFQjU3MkI1QjEKUldTeHRYSzFyaFZ0Vnp3WFZ2RktJQndvN2NSQXNSaGYvNjJGakNDdTVZWEpjUWdwaUsvWEFxVDIK",
      "requireSignedVersion": true
    }
  }
}
