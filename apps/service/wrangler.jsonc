{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawjivo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mawjivo-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mawjivo-media" }],
  "workflows": [
    { "binding": "PUBLISH", "name": "mawjivo-publish", "class_name": "PublishWorkflow" },
  ],
  "vars": {
    "SERVICE_ID": "local-service",
    "SERVICE_VERSION": "0.1.1",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "MEDIA_BUCKET": "mawjivo-media",
  },
  "secrets": { "required": ["SERVICE_ENCRYPTION_KEY", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"] },
}
